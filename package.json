{
  "name": "site-world",
  "version": "0.1.0",
  "description": "A walkable 3D operations room for React Three Fiber: rooms, doors, terminals, walk physics, and a demon mini-game.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makektm/site-world.git"
  },
  "keywords": [
    "react-three-fiber",
    "three.js",
    "3d",
    "dashboard",
    "walk-mode",
    "terminal"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "reference": "node scripts/reference.mjs",
    "check": "bun run typecheck && bun run test",
    "example": "bun run --filter site-world-example-basic dev"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "maath": "^0.10.8",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/three": "^0.186.0",
    "jsdom": "^26",
    "maath": "^0.10.8",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0",
    "typescript": "^5.9.3",
    "vitest": "^3"
  }
}
